class Solution {
    public ArrayList<Integer> topoSort(int V, int[][] edges) {
        // using bfs (kahn's algo) based on in-degrees of nodes
        
        ArrayList<Integer> res= new ArrayList<>();
        // 1. adj list
        ArrayList<ArrayList<Integer>> adj= new ArrayList<>();
        for(int i=0; i<V; i++){
            adj.add(new ArrayList<>());
        }
        for(int edge[] : edges){
            adj.get(edge[0]).add(edge[1]);
        }
        //2. created indegrees
        int[] indegree=new int[V];
        for(int u=0; u<V; u++){
            for(int v :adj.get(u)){
                indegree[v]++;
            }
        }
        // 3. queue creation and adding to queue the items that are having the indegree 0 initiallly.
        Queue<Integer> q= new LinkedList<>();
        for(int i=0; i<V; i++){
            if(indegree[i]==0) {
                q.offer(i);
            }
        }
        // 4. bfs
        while(!q.isEmpty()){
            int u=q.poll();
            // q.poll();
            res.add(u);
            for(int v: adj.get(u)){
                indegree[v]--;
                if(indegree[v]==0) q.offer(v);
            }
        }
        return res;
    }
}
