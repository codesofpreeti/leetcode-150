class Solution {
    public boolean isCyclic(int V, int[][] edges) {
        // using bfs, aka toplogical, aka kahn's
        int count=0;
        ArrayList<ArrayList<Integer>> adj= new ArrayList<>();
        for(int i=0; i<V; i++){
            adj.add(new ArrayList<>());
        }
        for(int edge[]: edges){
            adj.get(edge[0]).add(edge[1]);
        }
        int[] ind= new int[V];
        for(int i=0; i<V; i++){
            for(int a :adj.get(i)){
                ind[a]++;
            }
        }
        Queue<Integer> q= new LinkedList<>();
        for(int i=0; i<V; i++){
            if(ind[i]==0) {
                q.offer(i);
                count++;
            }
        }
        while(!q.isEmpty()){
            int u=q.poll();
            for(int v: adj.get(u)){
                ind[v]--;
                if(ind[v]==0){
                    q.offer(v);
                    count++;
                }
            }
        }
        return count==V ? false :true;
        
    }
}
