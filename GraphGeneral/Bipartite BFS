class Solution {
    public boolean isBipartite(int[][] graph) {
        int V=graph.length;
        int[] color= new int[V];
        Arrays.fill(color, -1);

        for(int i=0; i<V; i++){
            if(color[i]==-1){
                if(CheckViaDFS(graph, i, color, 1)==false) return false;
            }
        }
        return true;
    }
    public boolean CheckViaDFS(int[][] graph, int u, int[] color, int currentCol){
        color[u]=currentCol;
        for(int v: graph[u]){
            if(color[v]==color[u]){
                return false;
            }
            else if(color[v]==-1){
                int colorV= 1-currentCol;
                if(CheckViaDFS(graph, v, color, colorV)==false) return false;
            }
        }
        return true;
    }
}
