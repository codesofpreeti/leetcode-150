class Solution {
    boolean cycle;
    public int[] findOrder(int numCourses, int[][] prerequisites) {
        //DFS
        ArrayList<Integer> res= new ArrayList<>();
        cycle=false;
        
        ArrayList<ArrayList<Integer>> adj= new ArrayList<>();
        for(int i=0; i<numCourses; i++){
            adj.add(new ArrayList<>());
        }
        for(int block[]:prerequisites ){
            adj.get(block[1]).add(block[0]);
        }
        Stack<Integer> stk= new Stack<>();
        boolean visited[]= new boolean[numCourses];
        boolean recStack[]= new boolean[numCourses];

        for(int i=0; i<numCourses; i++){
            if(!visited[i]) DFS(i , adj, stk, visited, recStack);
        }

        if(cycle) return new int[0];
        while(!stk.isEmpty()){
            res.add(stk.pop());
        }
        int ans[]= new int[numCourses];
        for(int i=0 ;i <numCourses; i++){
            ans[i]=res.get(i);
        }
        return ans;
    }
    public void DFS(int u, ArrayList<ArrayList<Integer>> adj, Stack<Integer> stk,boolean visited[], boolean recStack[] ){
        visited[u]=true;
        recStack[u]=true;

        for(int v: adj.get(u)){
            if(recStack[v]==true) {
                cycle=true;
                return;
            }
            if(!visited[v] ) DFS(v, adj, stk, visited, recStack);
        }
        
        stk.push(u);
        recStack[u]=false;
    }
}
